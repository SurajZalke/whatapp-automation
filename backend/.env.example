# SK Agent — Environment Variables
# Copy this file to .env and fill in your values for local development.
# On Render: set these in Dashboard → your service → Environment tab.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Owner ──────────────────────────────────────────────────────────────────────
OWNER_NAME=Suraj Zalke
OWNER_SHORT_NAME=Suraj

# ── Groq API Keys (primary LLM — fast) ────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY1=your_groq_key2_here
GROQ_API_KEY2=your_groq_key3_here
GROQ_API_KEY3=your_groq_key4_here

# ── Gemini API Keys (fallback LLM + Vision for images) ────────────────────────
GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEY2=your_gemini_key2_here
GEMINI_API_KEY3=your_gemini_key3_here

# ── Ollama (local fallback — leave blank on Render) ───────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# ── Render auto-sets this — do NOT set manually on Render ─────────────────────
# RENDER_EXTERNAL_URL=https://your-service-name.onrender.com
# SELF_URL=https://your-service-name.onrender.com  ← only if NOT on Render
